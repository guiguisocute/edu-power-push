# ============================================================================
# APP_ENV：development | test | production —— 写错直接启动失败，禁止静默降级。
#
#                    development        test                production
#   用途             本机 + Mailpit     测试域名/内网        正式对外
#   AUTH_COOKIE_SECURE 默认 false        默认 false          强制 true（HTTPS）
#   ADMIN_TOKEN      随意               必须 32+            强制 32+
#   AUTH_JWT_SECRET  可空（关闭账号体系）可空                强制存在
#   HTTP_ADDR        127.0.0.1:8080     容器内 0.0.0.0:8080  容器内 0.0.0.0:8080
#   SCAN_QPS/并发    0.5/1（安全默认）  实测值 3/6           实测值 3/6
#
# 域名不出现在任何配置里。API 只监听回环/容器网络。
# 对外入口由反向代理决定。前端与 API 同源。
# 换域名无需改此处任何一行。
# ============================================================================
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai

# --- 基础设施隔离（每个环境必须给不同值）--------------------------------------
# compose 用它给容器和卷加前缀：<project>_postgres-data 就是该环境专属的数据库卷。
# **改这个值等于换一个空数据库**。已有环境禁止改名。
COMPOSE_PROJECT_NAME=edu-power-push-dev
# 每个环境钉自己的镜像 tag，避免测试环境 docker load 顶掉生产正在用的镜像。
APP_IMAGE=edu-power-push:dev
# 宿主回环端口。两环境同机时必须错开（反代按域名分流到各自端口）。
API_PORT=8080
# -----------------------------------------------------------------------------

# --- 采集哪一所学校 -----------------------------------------------------------
# 这三个均可留空。留空时服务照常启动、面板照常可登，只是采集器全部跳过。
# 优先做法：启动后去运维面板「扫描器 → 学校」搜索选择。该配置会覆盖此处。
#
# PROVIDER 选用哪套爬虫（backend/internal/provider 下注册的名字）。
# 只注册了一套时可留空。接自有学校爬虫见 docs/PROVIDERS.md。
PROVIDER=
# 上游的 areaId。内置 bdfairy 实测支持 55 所学校，清单在面板下拉中。
AREA_ID=
# 学校名，仅用于展示与日志。留空则从清单补全。
AREA_NAME=
# 上游入口。留空 = 使用所选 PROVIDER 自己的默认地址。
ELECTRICITY_BASE_URL=
# 余额、日明细、月账单允许重叠。以下是所有 API/worker/admin 进程合计的硬上限。
# GLOBAL 只是默认值：面板保存过共享闸门后，以 system_settings 为准。
# MAX 才是面板不可越过的上限。改它需要重新发布。
UPSTREAM_GLOBAL_QPS=12
UPSTREAM_GLOBAL_CONCURRENCY=12
UPSTREAM_MAX_QPS=30
UPSTREAM_MAX_CONCURRENCY=16
# 闸门的并发槽占用池连接。池子同时是「上游最多几个请求在飞」的硬上限：
# 必须 >= UPSTREAM_MAX_CONCURRENCY + 8（留给写结果、心跳、面板查询）。
DATABASE_MAX_CONNS=24

# Redis 只承载可丢弃缓存。生产必须生成独立随机密码；不进数据库备份。
REDIS_IMAGE=redis:8.8-alpine
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=16
REDIS_PREFIX=edu-power
REDIS_MAXMEMORY=256mb
REDIS_CONTAINER_MEMORY=320m

DATABASE_URL=

# Docker Compose database/bootstrap values. Generate both secrets independently.
# 每个环境一套独立的库与口令。测试环境密码禁止与生产相同。
# 否则「隔离」只剩容器名不同。
POSTGRES_USER=edu_power
POSTGRES_DB=edu_power
POSTGRES_PASSWORD=
# PostgreSQL 内存参数。下列默认值适合本机。4GB 测试机可用 1GB/3GB/16MB/256MB。
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=8GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=512MB

HTTP_ADDR=127.0.0.1:8080
# 机器用的全权令牌（CI、迁移脚本、自举第一个管理员）。**禁止放进浏览器**。
# 人走 Web 管理面板：账号角色鉴权，见 docs/ADMIN-PANEL.md。
ADMIN_TOKEN=

# system_settings 与用户自带推送 token 的 AES-256-GCM 密钥：32 字节，base64 或 hex。
#   openssl rand -base64 32
# 留空不会导致启动失败。但管理面板邮件凭证及 Telegram/PushPlus token
# 都会被拒绝保存。必须拒绝明文落库，禁止将 API key 明文存进数据库。
# 换掉该值会使已存凭证无法解密（面板会提示重新填写）。备份时须单独留一份。
SETTINGS_ENCRYPTION_KEY=

# Authenticate the edge-generated X-Rate-Proxy-Key. Generate with:
#   openssl rand -hex 32
# Configure the same value as rate_proxy_secret on the public gateway.
# When blank, the backend ignores all client-supplied rate keys.
AUTH_RATE_PROXY_SECRET=

# Product user auth: email + password, short access JWT, rotating refresh JWT.
# Generate a separate random value; do not reuse ADMIN_TOKEN or database credentials.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=edu-power-push
AUTH_ACCESS_TTL_SEC=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=edu_power_refresh
# 留空 = 按 APP_ENV 取默认值（production→true，其余→false）。
# 仅当「服务端与浏览器都在回环、无公网代理」的 HTTP 部署时才写 false。
AUTH_COOKIE_SECURE=

# 第三方登录（Google / GitHub）。
#
# **优先在管理面板配置**：「前端展示 · 登录与注册 · 第三方登录凭证」。
# 填完立即生效。secret 加密进库。无需改本文件，无需重启。
# 下列变量是**兜底**：面板留空的栏才使用它们。
#
# 两家都是「配了才有」：都未配置时登录页不出现对应按钮。
# 端点也直接挡回用户，而不是送到提供方后再被难懂的错误页拦截。
# ID 与 Secret 必须成对出现。此处只填一个会直接启动失败
# （表现为「按钮不见了」，排查无线索，因此让启动失败更早暴露）。
#
# 回调地址 = OAUTH_BASE_URL + /api/v1/auth/oauth/{google|github}/callback。
# 必须与提供方后台登记的重定向 URI 完全一致（面板上有可复制地址）。
# 留空则用 PUBLIC_BASE_URL。禁止从请求 Host 现推：
# 代理后面的 Host 可被伪造，用它拼回调等于让他人指定授权码投递地址。
#   Google  https://console.cloud.google.com/apis/credentials → OAuth 2.0 客户端 ID（Web 应用）
#   GitHub  https://github.com/settings/developers → OAuth Apps → New OAuth App
OAUTH_BASE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=


# 高风险动作的人机验证。运行期可在 Admin 面板切换。此处为尚未保存面板设置时的回退值。
CAPTCHA_PROVIDER=disabled
CAPTCHA_ACTIONS=auth.login,auth.register_code,auth.password_reset_code,meter.preview
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 可选。填写后 Siteverify 返回的 hostname 必须完全匹配。
TURNSTILE_HOSTNAME=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

SCAN_CRON=
# 已注册用户当前绑定的有效电表，每小时优先刷新一次。
BOUND_SCAN_CRON=5 * * * *
SCAN_CONCURRENCY=1
SCAN_QPS=0.5
SCAN_MAX_CONCURRENCY=16
SCAN_MAX_QPS=20
SCAN_TIMEOUT_SEC=20
SCAN_RETRY_MAX=3
SCAN_RETRY_BASE_DELAY_MS=1000
SCAN_RETRY_MAX_DELAY_MS=30000
SCAN_STALE_AFTER_HOURS=36
SCAN_RESULT_RETENTION_DAYS=180
LOG_RETENTION_DAYS=30

# From day 2 onward, retry at 03:00 until this month's one scheduled run exists.
BILL_CRON=0 19 1 * *
BILL_CONCURRENCY=4
BILL_QPS=5
BILL_RETRY_MAX=1
BILL_MONTH_RETRY_MAX=1
BILL_MAX_CONCURRENCY=16
BILL_MAX_QPS=30

# 官方日明细。首次任务从 2025-01 回填到当前月。回填结束后只抓当月，月初补抓上月。
DETAIL_CRON=30 6 * * *
# 首扫后仅补抓昨日尚未出现明确 ydl 行的表。留空可禁用。
DETAIL_RETRY_CRON=15 10 * * *
DETAIL_BOOTSTRAP_FROM=2025-01
# 默认只抓日常增量。灾难恢复时显式运行 admin detail-scan --full --bootstrap。
DETAIL_AUTO_BOOTSTRAP=false
DETAIL_CONCURRENCY=8
DETAIL_QPS=8
DETAIL_RETRY_MAX=1
DETAIL_MONTH_RETRY_MAX=1
DETAIL_MAX_CONCURRENCY=16
DETAIL_MAX_QPS=30

# 邮件通道三选一：resend（当前测试阶段用它）| smtp | tencent_ses（代码保留，模板审核较慢）
MAIL_PROVIDER=
# 发件人。resend 时必须是 Resend 里**已验证域名**下的地址，可带显示名：
#   MAIL_FROM=POWER·PUSH <noreply@你的邮件域名>
MAIL_FROM=
MAIL_ADMIN_TO=
# Shared, database-backed budget for registration/recovery/change-email code mail.
MAIL_USER_LIMIT_PER_MINUTE=20
MAIL_USER_LIMIT_PER_DAY=500
# 邮件正文中的站点链接前缀（退订、重置密码按钮）。留空则按钮点不动，但邮件仍能发出。
PUBLIC_BASE_URL=

# Resend（https://resend.com）
RESEND_API_KEY=
RESEND_REPLY_TO=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# tls or starttls for remote SMTP; none is accepted only for loopback Mailpit/tests.
SMTP_TLS_MODE=

TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=
TENCENT_SES_FROM_EMAIL=
TENCENT_SES_TEMPLATE_ID=

# Local test profile only (Mailpit web UI). Never enable Mailpit in production.
MAILPIT_UI_PORT=8025
