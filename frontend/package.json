{
  "name": "edu-power-push-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "preview:test": "vite preview --mode test",
    "smoke": "vite build --ssr src/smoke.tsx --outDir .smoke --logLevel error && node .smoke/smoke.js"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
