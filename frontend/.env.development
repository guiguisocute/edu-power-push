# 本机开发（pnpm dev）。默认 mock，不需要后端也能跑通全部界面。
# 要连真后端：先开隧道 `ssh -N -L 8080:127.0.0.1:8080 <你的服务器>`，再访问 ?api=live。

VITE_API_MODE=mock

# 本机开发默认开着，方便调管理界面（还需要 ?api=live + 一个运维账号）
VITE_ADMIN_PANEL=true

# dev server 的 /api、/health 转发目标。**没有 VITE_ 前缀 ⇒ 只在 vite.config.ts 里用，
# 不会进浏览器产物**，所以这里写内网地址是安全的。
DEV_API_PROXY=http://127.0.0.1:8080
