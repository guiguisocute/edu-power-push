# 所有环境共享的默认值（会打进构建产物，**不要放任何密钥**）。
# 单个环境的覆盖写在 .env.development / .env.test / .env.production，
# 个人机器上的临时覆盖写 .env.local（已 gitignore）。

# API 基址。留空 = 同源（/api、/health 由反代或 vite proxy 转发）。
# 保持留空，域名就永远不进代码 —— 换测试域名/正式域名都不用改前端。
VITE_API_BASE=

# 数据来源：mock = 原型确定性数据；live = 后端 /api/v1 真实数据。
# 运行时还可以用 ?api=live / ?api=mock 临时切换（写 localStorage）。
VITE_API_MODE=mock

# 管理界面是否编译进产物。它是登录后侧栏里的「系统管理」一组，只对运维/管理员出现。
# 关掉时那一组不会出现，代码也不会进 bundle —— 对外发布的产物没必要带着运维界面。
VITE_ADMIN_PANEL=false
